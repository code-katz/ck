{
  "description": "ck: persona usage log, a check that the old team tool is gone, the memory gate, the project's team, and the session cost (a line after each answer once there is a pull request, and the table on the pull request at merge)",
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "^ck:",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/usage-log.sh\"" }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/check-prereqs.sh\"" },
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/memory-gate.py\" rule" },
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/team.py\" context" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Write|Edit|MultiEdit|Bash)$",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/memory-gate.py\" check" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/cost.py\" merge", "timeout": 60 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/cost.py\" stop", "timeout": 20 }
        ]
      }
    ]
  }
}
